<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>get-task-allow</key>
    <true/>
    <key>task_for_pid-allow</key>
    <true/>
    <key>com.apple.system-task-ports</key>
    <true/>
    <key>com.apple.system-task-ports.active</key>
    <true/>
    <key>com.apple.system-task-ports.control</key>
    <true/>
    <key>proc_info-allow</key>
    <true/>
    <key>com.apple.runningboard.terminateprocess</key>
    <true/>
    <key>com.apple.private.memorystatus</key>
    <true/>
    <key>com.apple.private.kernel.jetsam</key>
    <true/>
    <key>com.apple.private.skip-library-validation</key>
    <true/>
    <key>com.apple.private.security.no-container</key>
    <true/>
    <key>com.apple.private.security.no-sandbox</key>
    <true/>
    <key>com.apple.private.security.container-required</key>
    <false/>
    <key>com.apple.private.security.container-manager</key>
    <true/>
    <key>com.apple.private.security.system-application</key>
    <true/>
    <key>com.apple.private.security.storage.AppDataContainers</key>
    <true/>
    <key>com.apple.private.security.storage.AppGroups</key>
    <true/>
    <key>com.apple.private.security.storage.AppBundles</key>
    <true/>
    <key>com.apple.private.security.storage.Photos</key>
    <true/>
    <key>com.apple.private.security.storage.System</key>
    <true/>
    <key>platform-application</key>
    <true/>
    <key>keychain-access-groups</key>
    <array>
        <string>*</string>
    </array>
    <key>com.apple.keystore.access-keychain-keys</key>
    <true/>
    <key>com.apple.keystore.lockassertion</key>
    <true/>
    <key>com.apple.keystore.sik.access</key>
    <true/>
    <key>com.apple.private.tcc.allow</key>
    <array>
        <string>kTCCServiceAppleMediaLibrary</string>
        <string>kTCCServiceSystemPolicyDocumentsFolder</string>
        <string>kTCCServiceSystemPolicyDesktopFolder</string>
        <string>kTCCServiceSystemPolicyDownloadsFolder</string>
        <string>kTCCServiceUbiquity</string>
    </array>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.exception.files.absolute-path.read-write</key>
    <array>
        <string>/</string>
    </array>
    <key>com.apple.security.exception.iokit-user-client-class</key>
    <array>
        <string>IOAccelerator</string>
        <string>IOGPUDeviceUserClient</string>
        <string>IOSurfaceRootUserClient</string>
    </array>
    <key>com.apple.security.iokit-user-client-class</key>
    <array>
        <string>IOSurfaceRootUserClient</string>
        <string>AGXDeviceUserClient</string>
        <string>IOHIDEventServiceFastPathUserClient</string>
    </array>
    <key>com.apple.private.mobileinstall.allowedSPI</key>
    <array>
        <string>Install</string>
        <string>InstallLocalProvisioned</string>
        <string>Uninstall</string>
        <string>UninstallForLaunchServices</string>
        <string>SetCapabilities</string>
        <string>Lookup</string>
        <string>InstallForLaunchServices</string>
        <string>CopyInstalledAppsForLaunchServices</string>
        <string>Browse</string>
    </array>
    <key>com.apple.private.MobileInstallationHelperService.allowed</key>
    <true/>
    <key>com.apple.private.MobileContainerManager.allowed</key>
    <true/>
    <key>com.apple.private.coreservices.canmaplsdatabase</key>
    <true/>
    <key>com.apple.private.launchservices.allowedSPI</key>
    <array>
        <string>allInstalledApplications</string>
        <string>allApplications</string>
        <string>applicationForIdentifier:</string>
        <string>applicationProxyForIdentifier:</string>
        <string>applicationsOfType:</string>
        <string>enumeratorWithOptions:</string>
    </array>
    <key>com.apple.private.lsapplicationworkspace.allowedSPI</key>
    <array>
        <string>allInstalledApplications</string>
        <string>allApplications</string>
        <string>applicationForIdentifier:</string>
        <string>applicationProxyForIdentifier:</string>
        <string>enumeratorWithOptions:</string>
    </array>
    <key>com.apple.lsapplicationworkspace.rebuildappdatabases</key>
    <true/>
    <key>com.apple.lsapplicationproxy.deviceidentifierforvendor</key>
    <true/>
    <key>com.apple.launchservices.clearadvertisingid</key>
    <true/>
    <key>com.apple.springboard.launchapplications</key>
    <true/>
    <key>com.apple.multitasking.termination</key>
    <true/>
    <key>com.apple.private.applecredentialmanager.allow</key>
    <true/>
    <key>com.apple.accounts.appleaccount.fullaccess</key>
    <true/>
    <key>com.apple.accounts.appleidauthentication.defaultaccess</key>
    <true/>
    <key>com.apple.private.accounts.allaccounts</key>
    <true/>
    <key>com.apple.itunesstored.private</key>
    <true/>
    <key>com.apple.itunesstored.accounts</key>
    <true/>
    <key>com.apple.private.persona-mgmt</key>
    <true/>
    <key>aps-connection-initiate</key>
    <true/>
    <key>checklessPersistentURLTranslation</key>
    <true/>
    <key>com.apple.SystemConfiguration.SCPreferences-write-access</key>
    <true/>
    <key>com.apple.private.xpc.domain-extension</key>
    <true/>
    <key>com.apple.private.xpc.domain-extension.proxy</key>
    <true/>
    <key>com.apple.private.xpc.launchd.job-manager</key>
    <string>com.apple.runningboard</string>
    <key>com.apple.runningboard.process-state</key>
    <true/>
</dict>
</plist>
